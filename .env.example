APP_NAME="Media Upload Manager"
APP_RELEASE=development
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://media-upload-manager.test
APP_TIMEZONE=UTC
LOCAL_AGENT_LOGIN_ENABLED=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

# Production sets these explicitly in deploy/production/.env.production.
# TRUSTED_HOSTS=media.example.com
# TRUSTED_PROXIES=172.16.0.0/12

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

TMDB_API_TOKEN=
TMDB_LANGUAGE=en-US
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_CACHE_TTL=86400
TMDB_CONNECT_TIMEOUT=3
TMDB_REQUEST_TIMEOUT=10

MEDIA_DISKS=
MEDIA_DEFAULT_RESERVE_GIB=20
MEDIA_REQUIRE_MOUNTPOINT=false

UPLOAD_TUS_PUBLIC_PATH=/uploads/tus/
TUS_INTERNAL_URL=http://127.0.0.1:1080/uploads/tus/
TUS_HOOK_URL=http://127.0.0.1:1081/internal/tus/hooks
TUS_HOOK_SECRET=
UPLOAD_CHUNK_SIZE_BYTES=67108864
UPLOAD_RETRY_DELAYS_MS=0,3000,5000,10000,20000
UPLOAD_INTERNAL_CONNECT_TIMEOUT_SECONDS=2
UPLOAD_INTERNAL_TIMEOUT_SECONDS=5
UPLOAD_TOKEN_TTL_SECONDS=900
UPLOAD_TOKEN_REFRESH_LEEWAY_SECONDS=60
UPLOAD_INACTIVITY_SECONDS=604800
UPLOAD_FINGERPRINT_WINDOW_BYTES=1048576
# TUS_METADATA_PATH=/absolute/persistent/tusd-metadata
FFPROBE_BINARY=/opt/homebrew/bin/ffprobe
FFPROBE_TIMEOUT_SECONDS=120
FFPROBE_MAX_OUTPUT_BYTES=1048576
FFPROBE_MAX_STREAMS=64
UPLOAD_PROCESSING_JOB_TIMEOUT_SECONDS=180
UPLOAD_PROCESSING_JOB_UNIQUE_SECONDS=3600
UPLOAD_PROCESSING_JOB_BACKOFF_SECONDS=15,60,180
UPLOAD_PROCESSING_POLL_INTERVAL_MS=1500
DB_QUEUE_RETRY_AFTER=240

PULSE_ENABLED=true
PULSE_EXCEPTION_CONTEXT_ENABLED=true
PULSE_STORAGE_KEEP="7 days"
PULSE_INGEST_KEEP="7 days"

# macOS development example (ordinary existing folders are supported):
# MEDIA_DISKS=local
# MEDIA_DISK_LOCAL_LABEL="Local Media"
# MEDIA_DISK_LOCAL_MOVIES_PATH="/Users/your-name/Movies/Jellyfin Movies"
# MEDIA_DISK_LOCAL_SERIES_PATH="/Users/your-name/Movies/Jellyfin Series"
# MEDIA_DISK_LOCAL_SERIES_DEFAULT_CATEGORY=tv
# MEDIA_DISK_LOCAL_RESERVE_GIB=5

# Linux production example (every path must be an exact container mount point):
# MEDIA_DISKS=nas_a,nas_b,nas_c
# MEDIA_REQUIRE_MOUNTPOINT=true
# MEDIA_DISK_NAS_A_LABEL="NAS A"
# MEDIA_DISK_NAS_A_MOVIES_PATH=/mnt/media/nas-a-movies
# MEDIA_DISK_NAS_A_SERIES_PATH=/mnt/media/nas-a-series
# MEDIA_DISK_NAS_A_SERIES_DEFAULT_CATEGORY=tv
# MEDIA_DISK_NAS_A_RESERVE_GIB=20
# MEDIA_DISK_NAS_B_LABEL="NAS B"
# MEDIA_DISK_NAS_B_MOVIES_PATH=/mnt/media/nas-b-movies
# MEDIA_DISK_NAS_B_SERIES_PATH=/mnt/media/nas-b-series
# MEDIA_DISK_NAS_B_SERIES_DEFAULT_CATEGORY=tv
# MEDIA_DISK_NAS_B_RESERVE_GIB=20
# MEDIA_DISK_NAS_C_LABEL="NAS C"
# MEDIA_DISK_NAS_C_MOVIES_PATH=/mnt/media/nas-c-movies
# MEDIA_DISK_NAS_C_SERIES_PATH=/mnt/media/nas-c-series
# MEDIA_DISK_NAS_C_SERIES_DEFAULT_CATEGORY=anime
# MEDIA_DISK_NAS_C_RESERVE_GIB=40
# MEDIA_DISK_<ID>_PATH remains a backward-compatible Movie-root alias.
# Omit MEDIA_DISK_<ID>_SERIES_DEFAULT_CATEGORY to keep that Series root manual.

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
