APP_NAME="Media Upload Manager"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://media-upload-manager.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

TMDB_API_TOKEN=
TMDB_LANGUAGE=en-US
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_CACHE_TTL=86400
TMDB_CONNECT_TIMEOUT=3
TMDB_REQUEST_TIMEOUT=10

MEDIA_DISKS=
MEDIA_DEFAULT_RESERVE_GIB=20
MEDIA_REQUIRE_MOUNTPOINT=false

# macOS development example (ordinary existing folders are supported):
# MEDIA_DISKS=movies_a,movies_b
# MEDIA_DISK_MOVIES_A_LABEL="Movies A"
# MEDIA_DISK_MOVIES_A_PATH="/Users/your-name/Movies/Jellyfin A"
# MEDIA_DISK_MOVIES_A_RESERVE_GIB=5
# MEDIA_DISK_MOVIES_B_LABEL="Movies B"
# MEDIA_DISK_MOVIES_B_PATH="/Volumes/Media/Jellyfin B"
# MEDIA_DISK_MOVIES_B_RESERVE_GIB=20

# Linux production example (every path must be an exact container mount point):
# MEDIA_DISKS=nas_a,nas_b,nas_c
# MEDIA_REQUIRE_MOUNTPOINT=true
# MEDIA_DISK_NAS_A_LABEL="Movies A"
# MEDIA_DISK_NAS_A_PATH=/mnt/media/nas-a
# MEDIA_DISK_NAS_A_RESERVE_GIB=20
# MEDIA_DISK_NAS_B_LABEL="Movies B"
# MEDIA_DISK_NAS_B_PATH=/mnt/media/nas-b
# MEDIA_DISK_NAS_B_RESERVE_GIB=20
# MEDIA_DISK_NAS_C_LABEL="Movies C"
# MEDIA_DISK_NAS_C_PATH=/mnt/media/nas-c
# MEDIA_DISK_NAS_C_RESERVE_GIB=40

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
