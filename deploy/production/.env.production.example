APP_IMAGE=ghcr.io/owner/media-upload-manager-app:v0.1.0-beta.2
NGINX_IMAGE=ghcr.io/owner/media-upload-manager-nginx:v0.1.0-beta.2
APP_UID=1000
APP_GID=1000
MEDIA_GID=${APP_GID}

APP_NAME="Media Upload Manager"
APP_KEY=
APP_URL=https://media.example.com
APP_TIMEZONE=Europe/Prague
LOG_LEVEL=warning
TRUSTED_HOSTS=media.example.com
TRUSTED_PROXIES=172.16.0.0/12

MYSQL_DATABASE=media_upload_manager
MYSQL_USER=media_upload_manager
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

TMDB_API_TOKEN=
TMDB_LANGUAGE=en-US

MEDIA_DISKS=nas_a,nas_b,nas_c
MEDIA_DEFAULT_RESERVE_GIB=20
MEDIA_DISK_NAS_A_LABEL="Movies A"
MEDIA_DISK_NAS_A_PATH=/mnt/media/nas-a
MEDIA_DISK_NAS_A_RESERVE_GIB=20
MEDIA_DISK_NAS_B_LABEL="Movies B"
MEDIA_DISK_NAS_B_PATH=/mnt/media/nas-b
MEDIA_DISK_NAS_B_RESERVE_GIB=20
MEDIA_DISK_NAS_C_LABEL="Movies C"
MEDIA_DISK_NAS_C_PATH=/mnt/media/nas-c
MEDIA_DISK_NAS_C_RESERVE_GIB=40

TUS_HOOK_SECRET=
UPLOAD_INACTIVITY_SECONDS=604800
UPLOAD_INTERNAL_CONNECT_TIMEOUT_SECONDS=2
UPLOAD_INTERNAL_TIMEOUT_SECONDS=5
UPLOAD_TOKEN_TTL_SECONDS=900
UPLOAD_TOKEN_REFRESH_LEEWAY_SECONDS=60
UPLOAD_FINGERPRINT_WINDOW_BYTES=1048576
UPLOAD_PROCESSING_JOB_TIMEOUT_SECONDS=180
UPLOAD_PROCESSING_JOB_UNIQUE_SECONDS=3600
UPLOAD_PROCESSING_JOB_BACKOFF_SECONDS=15,60,180
UPLOAD_PROCESSING_POLL_INTERVAL_MS=1500
DB_QUEUE_RETRY_AFTER=240

PULSE_STORAGE_KEEP="7 days"
PULSE_INGEST_KEEP="7 days"
PULSE_SERVER_NAME=media-home-server

CLOUDFLARE_TUNNEL_TOKEN=
