# Add inside the secured media-upload-manager.test server block.
location = /internal/tus/authorize {
    allow 127.0.0.1;
    allow ::1;
    deny all;
    try_files $uri /index.php?$query_string;
}

location = /internal/tus/hooks {
    allow 127.0.0.1;
    allow ::1;
    deny all;
    try_files $uri /index.php?$query_string;
}

location ^~ /uploads/tus/ {
    if ($request_method = OPTIONS) {
        add_header Tus-Resumable "1.0.0" always;
        add_header Tus-Version "1.0.0" always;
        add_header Tus-Extension "creation,termination" always;
        return 204;
    }

    limit_except POST PATCH HEAD DELETE OPTIONS {
        deny all;
    }

    auth_request /_mum_tus_authorize;
    client_max_body_size 65m;
    client_body_buffer_size 64k;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_http_version 1.1;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;

    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    proxy_pass http://127.0.0.1:1080;
}

location = /_mum_tus_authorize {
    internal;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host media-upload-manager.test;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Original-Method $request_method;
    proxy_set_header X-Original-Uri $request_uri;
    proxy_set_header Tus-Resumable $http_tus_resumable;
    proxy_set_header Upload-Length $http_upload_length;
    proxy_set_header Upload-Offset $http_upload_offset;
    proxy_set_header Upload-Metadata $http_upload_metadata;
    proxy_set_header Upload-Defer-Length $http_upload_defer_length;
    proxy_set_header Upload-Concat $http_upload_concat;
    proxy_ssl_server_name on;
    proxy_pass https://media-upload-manager.test/internal/tus/authorize;
}
